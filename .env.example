# Copy to backend/.env and fill in your keys. Never commit backend/.env.

# Razorpay TEST MODE keys (Dashboard -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# Razorpay webhook secret (set when registering the webhook endpoint)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional overrides
# SQLite is the default so the project runs with no database to provision.
# The schema is engine-agnostic - point this at Postgres and nothing else
# changes (install the driver first: pip install psycopg2-binary):
#   DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/revpulse
# On Postgres, use Alembic for migrations rather than db.ensure_columns(),
# which is a SQLite-only stand-in and no-ops elsewhere.
DATABASE_URL=sqlite:///./revpulse.db
