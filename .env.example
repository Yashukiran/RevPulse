# Copy to backend/.env and fill in your keys. Never commit backend/.env.

# Razorpay TEST MODE keys (Dashboard -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# Razorpay webhook secret (set when registering the webhook endpoint)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional overrides
DATABASE_URL=sqlite:///./revpulse.db
